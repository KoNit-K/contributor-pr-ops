{
  "name": "contributor-pr-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-only contributor pull request operations and contribution evidence",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pr-ops": "dist/cli.js"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/static-check.mjs",
    "test": "npm run build && vitest run",
    "build": "tsc -p tsconfig.build.json",
    "public-check": "node scripts/public-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run public-check",
    "acceptance": "npm run build && vitest run && node scripts/clean-install.mjs"
  },
  "dependencies": {
    "@octokit/core": "6.1.3",
    "@octokit/plugin-paginate-rest": "11.4.0",
    "@octokit/plugin-throttling": "9.4.0",
    "commander": "14.0.1",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "source-map-js": "1.2.1",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
